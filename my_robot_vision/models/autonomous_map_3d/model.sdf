<?xml version="1.0"?>
<sdf version="1.6">
  <model name="autonomous_map_3d">
    <static>true</static>
    <link name="map_link">
      <visual name="textured_map_visual">
        <geometry>
          <mesh>
            <uri>model://autonomous_map_3d/meshes/autonomous_map_3d.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="floor_collision">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>4.0 4.0 0.02</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
