<?xml version="1.0"?>
<sdf version="1.6">
  <model name="track_preview_car">
    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="body">
      <gravity>true</gravity>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name="chassis_visual">
        <pose>0 0 0.065 0 0 0</pose>
        <geometry>
          <box>
            <size>0.26 0.14 0.055</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.20 0.70 1</ambient>
          <diffuse>0.12 0.28 0.88 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
      <visual name="roof_visual">
        <pose>-0.005 0 0.115 0 0 0</pose>
        <geometry>
          <box>
            <size>0.14 0.105 0.045</size>
          </box>
        </geometry>
        <material>
          <ambient>0.65 0.78 0.95 0.92</ambient>
          <diffuse>0.75 0.86 0.98 0.92</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
      <visual name="front_marker_visual">
        <pose>0.105 0 0.083 0 0 0</pose>
        <geometry>
          <box>
            <size>0.025 0.075 0.018</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.85 0.20 1</ambient>
          <diffuse>1.0 0.88 0.25 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="camera_lens_visual">
        <pose>0.138 0 0.126 0 0 0</pose>
        <geometry>
          <box>
            <size>0.016 0.040 0.022</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.025 1</ambient>
          <diffuse>0.04 0.04 0.05 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <visual name="camera_view_left_ray_visual">
        <pose>1.6700 1.1500 0.3350 0.0000 0.0505 0.6109</pose>
        <geometry>
          <box>
            <size>3.6800 0.008 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 1.00 1.00 0.82</ambient>
          <diffuse>0.85 1.00 1.00 0.82</diffuse>
          <emissive>0.20 0.55 0.75 1</emissive>
        </material>
      </visual>
      <visual name="camera_view_center_ray_visual">
        <pose>1.6700 0.0000 0.3350 0.0000 0.0555 0.0000</pose>
        <geometry>
          <box>
            <size>3.0647 0.008 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 1.00 1.00 0.82</ambient>
          <diffuse>0.85 1.00 1.00 0.82</diffuse>
          <emissive>0.20 0.55 0.75 1</emissive>
        </material>
      </visual>
      <visual name="camera_view_right_ray_visual">
        <pose>1.6700 -1.1500 0.3350 0.0000 0.0505 -0.6109</pose>
        <geometry>
          <box>
            <size>3.6800 0.008 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 1.00 1.00 0.82</ambient>
          <diffuse>0.85 1.00 1.00 0.82</diffuse>
          <emissive>0.20 0.55 0.75 1</emissive>
        </material>
      </visual>
      <visual name="debug_origin_marker_visual">
        <pose>0 0 0.165 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.018</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1.0 0.02 0.02 1</ambient>
          <diffuse>1.0 0.04 0.04 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <!-- Matches the footprint checker in gazebo_track_car.py. -->
      <visual name="debug_ground_origin_visual">
        <pose>0 0 -0.017 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.004</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.02 0.02 1</ambient>
          <diffuse>1.0 0.04 0.04 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <visual name="debug_ground_footprint_front_visual">
        <pose>0.165 0 -0.017 0 0 0</pose>
        <geometry>
          <box>
            <size>0.008 0.238 0.004</size>
          </box>
        </geometry>
        <material>
          <ambient>0.00 0.70 1.00 1</ambient>
          <diffuse>0.05 0.86 1.00 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <visual name="debug_ground_footprint_rear_visual">
        <pose>-0.145 0 -0.017 0 0 0</pose>
        <geometry>
          <box>
            <size>0.008 0.238 0.004</size>
          </box>
        </geometry>
        <material>
          <ambient>0.00 0.70 1.00 1</ambient>
          <diffuse>0.05 0.86 1.00 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <visual name="debug_ground_footprint_left_visual">
        <pose>0.010 0.115 -0.017 0 0 0</pose>
        <geometry>
          <box>
            <size>0.318 0.008 0.004</size>
          </box>
        </geometry>
        <material>
          <ambient>0.00 0.70 1.00 1</ambient>
          <diffuse>0.05 0.86 1.00 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <visual name="debug_ground_footprint_right_visual">
        <pose>0.010 -0.115 -0.017 0 0 0</pose>
        <geometry>
          <box>
            <size>0.318 0.008 0.004</size>
          </box>
        </geometry>
        <material>
          <ambient>0.00 0.70 1.00 1</ambient>
          <diffuse>0.05 0.86 1.00 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <visual name="rear_left_dummy_wheel_visual">
        <pose>-0.080 0.085 0.032 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.028</radius>
            <length>0.016</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.07 0.07 0.07 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <visual name="rear_right_dummy_wheel_visual">
        <pose>-0.080 -0.085 0.032 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.028</radius>
            <length>0.016</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.07 0.07 0.07 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <collision name="rear_left_caster_collision">
        <pose>-0.095 0.072 0.026 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.024</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="rear_right_caster_collision">
        <pose>-0.095 -0.072 0.026 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.024</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <collision name="body_collision">
        <pose>0 0 0.065 0 0 0</pose>
        <geometry>
          <box>
            <size>0.26 0.14 0.05</size>
          </box>
        </geometry>
      </collision>
      <sensor name="front_camera" type="camera">
        <pose>0.14 0 0.42 0 0.18 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>2.45</horizontal_fov>
          <image>
            <width>960</width>
            <height>540</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>6.0</far>
          </clip>
        </camera>
        <plugin name="front_camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/track_preview_car</namespace>
            <remapping>image_raw:=image_raw</remapping>
            <remapping>camera_info:=camera_info</remapping>
          </ros>
          <camera_name>camera</camera_name>
          <frame_name>track_preview_car/front_camera</frame_name>
        </plugin>
      </sensor>
    </link>
    <link name="left_wheel">
      <gravity>true</gravity>
      <pose>0.080 0.088 0.032 0 0 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00005</ixx>
          <iyy>0.00008</iyy>
          <izz>0.00005</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name="left_wheel_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.030</radius>
            <length>0.020</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.07 0.07 0.07 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <collision name="left_wheel_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.030</radius>
            <length>0.020</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <link name="right_wheel">
      <gravity>true</gravity>
      <pose>0.080 -0.088 0.032 0 0 0</pose>
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00005</ixx>
          <iyy>0.00008</iyy>
          <izz>0.00005</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <visual name="right_wheel_visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.030</radius>
            <length>0.020</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.03 0.03 0.03 1</ambient>
          <diffuse>0.07 0.07 0.07 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <collision name="right_wheel_collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.030</radius>
            <length>0.020</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.2</mu>
              <mu2>1.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>body</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
        </limit>
      </axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>body</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.0e16</lower>
          <upper>1.0e16</upper>
        </limit>
      </axis>
    </joint>
    <plugin name="track_preview_car_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/track_preview_car</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.176</wheel_separation>
      <wheel_diameter>0.06</wheel_diameter>
      <max_wheel_torque>2.0</max_wheel_torque>
      <max_wheel_acceleration>8.0</max_wheel_acceleration>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>body</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <update_rate>50</update_rate>
    </plugin>
  </model>
</sdf>
